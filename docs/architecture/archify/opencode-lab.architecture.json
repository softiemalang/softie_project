  "cards": [
    {
      "title": "Execution",
      "dot": "cyan",
      "items": ["Mac Web/Desktop observes or instructs through the explicit SSH local forward; iPhone uses the tailnet-only HTTPS edge and receives no client Basic Auth prompt.", "OpenCode server, workspace, model, and tools run on the Galaxy Tab; v2.0.3 upstream auth remains inside the Lab proxy boundary."]
    },
    {
      "title": "Isolation",
      "dot": "emerald",
      "items": ["Lab root, HOME/XDG namespace, state, config, proxy, and upstream-only password are separate from Codex Remote/Console.", "Inside the Lab, native file/search/web tools are automatic while shell remains guarded; external filesystem, secret patterns, remote/destructive commands, and protected paths are denied.", "No Mac checkout, credential directory, archive, or operating state is bound into the Lab."]
    },
    {
      "title": "Resource handoff",
      "dot": "rose",
      "items": ["labctl stop writes a disabled marker and terminates only the Lab server/proxy process-group; main SSH daemon and checkout remain available.", "A subsequent start restores the Lab server/proxy pair, while the supervisor never overrides an explicit stop."]
    },
    {
      "title": "Experiment scope",
      "dot": "amber",
      "items": ["Spark 1.3 Free xhigh is verified with synthetic prompts only.", "Future free/API/local models and tools remain Lab-only pilot candidates, not product or credential paths."]
    },
    {
      "title": "Service continuity",
      "dot": "slate",
      "items": ["Termux:Boot starts a PPID 1 low-load supervisor that recovers only the existing Lab server/proxy pair.", "No heavy experiment, model, session, tool, wake-lock, Funnel, or direct Tab publication starts automatically."]
    },
