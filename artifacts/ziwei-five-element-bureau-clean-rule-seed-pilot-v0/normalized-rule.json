  "formulas": {
    "mingGongIndex": "(monthPalaceIndex-index(hourBranch)) mod 12",
    "mingGongStem": "(index(yinStem)+index(mingGongBranch)-index(寅)) mod 10",
    "monthPalaceIndex": "(index(寅)+lunarMonth-1) mod 12",
    "yinStem": "甲己丙寅頭;乙庚戊寅頭;丙辛庚寅頭;丁壬壬寅頭;戊癸甲寅頭"
  },
  "inputs": {
