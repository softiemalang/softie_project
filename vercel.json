      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*,.agents/**,.{codex,github}/**,{docs,artifacts,src,tools,ops,references,schemas,scratch,spikes,supabase,scripts,test,dist}/**,.vercel_python_packages/**,*.*,JPLEPH}"
