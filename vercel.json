{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/astrology.py": {
      "maxDuration": 60,
      "includeFiles": "{api/provider/de405.bsp,api/provider/de405-only-release-contract-v1.json,api/provider/NOTICE.md,scripts/astrology-jplephem-producer.py,test/fixtures/astrology/provider-equivalence-v1.json}",
      "excludeFiles": "{.env,.env.*,**/.env,**/.env.*,.agents/**,.codex/**,.git/**,.vercel/**,docs/**,artifacts/**,src/**,tools/**,test/**/*.test.js,test/**/*.test.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
